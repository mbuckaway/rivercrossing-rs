<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="RiverCrossing"
      Manufacturer="Mark Buckaway"
      Version="$(var.AppVersion)"
      UpgradeCode="{7231BFE8-E89F-4C1C-B79C-627C070DEDA9}"
      Scope="perUserOrMachine"
      Language="1033">

    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="RiverCrossing" />
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="*">
        <File Id="MainExecutableFile"
            Source="$(var.SourceDir)\rivercrossing.exe" KeyPath="yes" />
      </Component>
      <Component Id="BrandIcon" Guid="*">
        <File Id="BrandIconFile" Source="$(var.SourceDir)\rivercrossing.ico" />
      </Component>
      <Component Id="LicenseText" Guid="*">
        <File Id="LicenseTextFile" Source="$(var.SourceDir)\LICENSE" />
      </Component>
      <Component Id="NoticeText" Guid="*">
        <File Id="NoticeTextFile" Source="$(var.SourceDir)\NOTICE" />
      </Component>
    </ComponentGroup>

    <!-- CardComponents is generated by package-windows.ps1 (one component per
         card bitmap); WiX v5 has no component-local <Files> glob. -->
    <Feature Id="Main" Title="RiverCrossing" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="CardComponents" />
    </Feature>
  </Package>
</Wix>
